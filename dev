from typing import Any, Callable, Generator


class Fail(Exception):
    """A command failed; propagate to the top level as an exit code."""

    def __init__(self, code: int) -> None:
        super().__init__(code)
        self.code = code


def fail(msg: str) -> None:
    print(msg, file=sys.stderr)
    raise Fail(1)


def sh(*cmd: str) -> None:
    cmd = tuple(str(c) for c in cmd if c is not None)
    print("$ " + " ".join(cmd), file=sys.stderr)
    if code := subprocess.run(cmd).returncode:
        raise Fail(code)


def sho(cmd: str) -> str:
    return subprocess.run(cmd.split(), capture_output=True, text=True).stdout.strip()


def cli(*args: Any, **kwargs: Any) -> Callable[[Any], Any]:
    """Declare a CLI command / arguments for that command."""

    def wrap(func: Any) -> Any:
        if not hasattr(func, "cli_args"):
            setattr(func, "cli_args", [])
        if args or kwargs:
            getattr(func, "cli_args").append((args, kwargs))
        return func

    return wrap


# Commands

ROOT = Path(__file__).parent.resolve()
CXX = "clang++"
CXXFLAGS = (
    "-Wall -Wextra -Werror -fcolor-diagnostics -ffunction-sections -fdata-sections -std=c++23"
    " -Isrc -isystem third-party"
    f" {sho('pkg-config --cflags sdl2')}"
)
LINKFLAGS = "-fcolor-diagnostics -Wl,--gc-sections -Wl,-no-undefined"
LIBS = sho("pkg-config --libs sdl2") + " -lGL"
CXXFLAGS_VARIANT = {
    "debug": "-O0 -g -DDEBUG",
    "profile": "-Os -g -fno-omit-frame-pointer -DNDEBUG",
    "release": "-Os -DNDEBUG",
}

THIRD_PARTY = {
    "doctest": "https://github.com/doctest/doctest/releases/download/v2.4.11/doctest.h",
    "kode-mono": (
        "https://raw.githubusercontent.com/isaozler/kode-mono/master/fonts/ttf/KodeMono-Regular.ttf"
    ),
}


def _generate_build_ninja(variant: str) -> str:
    lines: list[str] = []

    make_font = ROOT / "tools" / "make_font.py"
    lines.append("rule font")
    lines.append(f"  command = uv run {make_font} -o $out")
    lines.append("  description = FONT $out")
    lines.append("  restat = 1")
    lines.append("")

    lines.append("rule cxx")
    lines.append(f"  command = {CXX} $cflags -c $in -o $out")
    lines.append("  depfile = $out.d")
    lines.append("  deps = gcc")
    lines.append("  description = CXX $out")
    lines.append("")

    link_cmd = f"{CXX} $in $ldflags -o $out"
    if variant == "release":
        link_cmd += " && strip $out"
    lines.append("rule link")
    lines.append(f"  command = {link_cmd}")
    lines.append("  description = LINK $out")
    lines.append("")

    lines.append(f"build gen/font_data.cpp: font {make_font}")
    lines.append("")

    cpps = sorted(Path("src").rglob("*.cpp"))
    cpps += [Path("gen/font_data.cpp")]
    obj_core, obj_prog, obj_test = [], [], []
    for cpp in cpps:
        obj = Path("obj") / Path(*cpp.parts[1:]).with_suffix(".o")
        cxxflags = f"{CXXFLAGS} {CXXFLAGS_VARIANT[variant]}"
        lines.append(f"build {obj}: cxx {cpp}")
        lines.append(f"  cflags = {cxxflags} -MMD -MF {obj}.d")
        lines.append("")

        if cpp.parent.name == "prog":
            obj_prog.append(obj)
        elif "tests" in cpp.parts:
            obj_test.append(obj)
        else:
            obj_core.append(obj)

    for prog in obj_prog:
        name = Path(prog).with_suffix("").name
        objs = obj_core + [prog] + (obj_test if name == "test" else [])
        lines.append(f"build {name}: link " + " ".join(map(str, objs)))
        lines.append(f"  ldflags = {LINKFLAGS} {LIBS}")
    lines.append("")
    lines.append("default game")

    return "\n".join(lines) + "\n"


@cli()
def clean(variant: str) -> None:
    """clean build artifacts"""
    variant_dir = ROOT / "build" / variant
    if variant_dir.exists():
        sh("rm", "-rf", str(variant_dir))


@cli("targets", nargs="*", help="targets to build")
def build(variant: str, targets: tuple[str, ...]) -> None:
    """build with ninja"""
    variant_dir = ROOT / "build" / variant
    variant_dir.mkdir(parents=True, exist_ok=True)

    for symdir in ("src", "third-party"):
        link = variant_dir / symdir
        if not link.exists():
            link.symlink_to(ROOT / symdir, target_is_directory=True)
    (variant_dir / "build.ninja").write_text(_generate_build_ninja(variant))

    sh("ninja", "-C", str(variant_dir), *targets)
    game = variant_dir / "game"
    if game.exists():
        print(f"  {game.stat().st_size / (1 << 20):.3f} MB  {game.relative_to(ROOT)}")


@contextmanager
def _gpu_top(path: Path | None) -> Generator[None, None, None]:
    if path is None:
        yield
    else:
        raw_path = path.with_suffix(path.suffix + ".raw")
        gpu_proc = subprocess.Popen(
            ["intel_gpu_top", "-J", "-s", "250", "-o", str(raw_path)]
        )
        try:
            yield
        finally:
            gpu_proc.terminate()
            gpu_proc.wait()
            with path.open("w") as f:
                subprocess.run(
                    [
                        sys.executable,
                        str(ROOT / "tools" / "intel_gpu_top_to_jsonl.py"),
                        str(raw_path),
                    ],
                    stdout=f,
                )
            raw_path.unlink(missing_ok=True)


@cli("program_args", nargs="*", help="program to run")
@cli("--reload", action="store_true", help="rebuild and restart on change")
@cli(
    "--with",
    dest="with_",
    action="append",
    choices=("perf", "gdb", "gpu"),
    help="run under perf/gdb, and/or capture GPU data (repeatable)",
)
def run(
    variant: str, program_args: tuple[str, ...], reload: bool, with_: list[str] | None
) -> None:
    """run the command (default: game)"""

    program_args = program_args or ("game",)
    program, *args = program_args
    variant_dir = ROOT / "build" / variant
    exe = variant_dir / program
    tools = set(with_ or ())
    perf_data = variant_dir / "perf.data"

    if reload and "gpu" in tools:
        fail("Cannot run --with gpu and --reload, which are mutually exclusive")
    if "perf" in tools and "gdb" in tools:
        fail("Cannot run --with perf and --with gdb, which are mutually exclusive")

    def cmd() -> list[str]:
        if "gdb" in tools:
            return ["gdb", "-ex", "run", "--args", str(exe), *args]
        if "perf" in tools:
            return ["perf", "record", "-g", "-o", str(perf_data), "--", str(exe), *args]
        return [str(exe), *args]

    if not reload:
        build(variant, (program,))
        with _gpu_top(variant_dir / "gpu.jsonl" if "gpu" in tools else None):
            sh(*cmd())
        if "perf" in tools:
            sh("perf", "report", "-i", str(perf_data))
        return

    def get_src_mtime() -> float:
        srcs = [str(p) for p in (ROOT / "src").rglob("*.cpp")]
        srcs += [str(p) for p in (ROOT / "src").rglob("*.hpp")]
        srcs += [str(ROOT / "dev")]
        return max(Path(s).stat().st_mtime for s in srcs if Path(s).exists())

    def get_exe_hash() -> str | None:
        if not exe.exists():
            return None
        h = hashlib.sha256()
        with open(exe, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 16), b""):
                h.update(chunk)
        return h.hexdigest()

    proc: subprocess.Popen[bytes] | None = None
    try:
        last_src_mtime = get_src_mtime()
        try:
            build(variant, (program,))
        except Fail:
            pass
        last_exe_hash = get_exe_hash()
        if last_exe_hash is not None:
            proc = subprocess.Popen(cmd())

        while proc is None or proc.poll() is None:
            time.sleep(0.1)
            src_mtime = get_src_mtime()
            if src_mtime <= last_src_mtime:
                continue
            last_src_mtime = src_mtime
            ts = time.strftime("%H:%M:%S")
            try:
                build(variant, (program,))
            except Fail:
                print(f"[{ts}] build failed (watching)")
                continue
            exe_hash = get_exe_hash()
            if exe_hash is None:
                continue
            if proc is None or exe_hash != last_exe_hash:
                last_exe_hash = exe_hash
                print(f"[{ts}] rebuilt (reloading)")
                if proc is not None and proc.poll() is None:
                    proc.terminate()
                    proc.wait()
                proc = subprocess.Popen(cmd())
            else:
                print(f"[{ts}] rebuilt (unchanged)")
    except KeyboardInterrupt:
        pass
    finally:
        if proc is not None and proc.poll() is None:
            proc.terminate()
            proc.wait()


@cli()
def ci(variant: str) -> None:
    """run continuous integration checks"""
    build(variant, targets=())
    run(variant, program_args=("test",), reload=False, with_=None)


def _read_profile(path: Path) -> list[tuple[float, float, float, float]]:
    """Read game.profile: [magic, count, (t_swap, t_frame, t_audio, n_samples)xN]."""
    data = path.read_bytes()
    if data[:4] != b"GPRF":
        fail(f"bad profile magic in {path}")
    (count,) = struct.unpack("<I", data[4:8])
    if len(data) < 8 + count * 4 * 4:
        fail(f"truncated profile in {path}")
    vals = struct.unpack(f"<{count * 4}f", data[8 : 8 + count * 4 * 4])
    return [
        (vals[4 * i], vals[4 * i + 1], vals[4 * i + 2], vals[4 * i + 3])
        for i in range(count)
    ]


def _p95(vals: list[float]) -> float:
    if not vals:
        return 0.0
    vals = sorted(vals)
    idx = int(0.95 * (len(vals) - 1))
    return vals[idx]


@cli("--timeout", type=float, default=60, help="period (s) to measure")
def report(variant: str, timeout: float) -> None:
    """run an AI sandbox benchmark and write a short report"""
    variant_dir = ROOT / "build" / variant
    profile = variant_dir / "game.profile"
    gpu = variant_dir / "gpu.jsonl"
    for path in (profile, gpu):
        if path.exists():
            path.unlink()
    run(
        variant,
        program_args=(
            "game",
            "player=ai",
            "mission=sandbox",
            f"timeout={timeout}",
            "profile=true",
        ),
        reload=False,
        with_=("gpu",),
    )

    frames = _read_profile(profile)
    if not frames:
        fail(f"no frames in {profile}")
    t_swap = [f[0] for f in frames]
    t_frame = [f[1] for f in frames]
    t_audio = [f[2] for f in frames]

    size = (variant_dir / "game").stat().st_size
    stamp = time.strftime("%Y%m%dT%H:%M")
    audio_busy = [
        t_audio[i] / (t_swap[i] + t_frame[i]) * 100.0 for i in range(len(frames))
    ]
    total_frame_time = [t_swap[i] + t_frame[i] for i in range(len(frames))]
    gpu_busy = []
    if gpu.exists():
        for line in gpu.read_text().splitlines():
            obj = json.loads(line)
            if "busy" in obj:
                gpu_busy.append(obj["busy"] * 100.0)

    def stats(vals: list[float]) -> tuple[float, float]:
        return statistics.mean(vals), _p95(vals)

    frame_avg, frame_p95 = stats(t_frame)
    total_avg, total_p95 = stats(total_frame_time)
    audio_avg, audio_p95 = stats(audio_busy)
    gpu_avg, gpu_p95 = stats(gpu_busy) if gpu_busy else (0.0, 0.0)

    report_path = variant_dir / "report.txt"
    report_path.write_text(
        f"# {stamp}\n"
        f"\n"
        f"Size: {size:,} bytes\n"
        f"\n"
        f"Frame time: {frame_avg * 1000:.0f} ms (p95 {frame_p95 * 1000:.1f} ms)\n"
        f"\n"
        f"FPS: {1.0 / total_avg:.0f} (lower p95 {1.0 / total_p95:.0f})\n"
        f"\n"
        f"GPU busy: {gpu_avg:.0f}% (p95 {gpu_p95:.0f}%)\n"
        f"\n"
        f"Audio busy: {audio_avg:.0f}% (p95 {audio_p95:.0f}%)\n"
    )
    print(report_path.read_text())


@cli()
def setup(variant: str) -> None:
    """download third-party dependencies"""

    for name, url in THIRD_PARTY.items():
        path = ROOT / "third-party" / name / Path(url).name
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.exists():
            print(f"Downloading {name}...")
            urllib.request.urlretrieve(url, str(path))
            print(f"  {path}")
        else:
            print(f"  {path} (exists)")


# Script
def _main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "-v",
        "--variant",
        action="append",
        choices=["debug", "profile", "release"],
    )
    parser.set_defaults(
        action=lambda variant: run(
            variant=variant,
            program_args=(),
            reload=True,
            with_=None,
        )
    )

    subs = parser.add_subparsers()
    for key, value in globals().items():
        if hasattr(value, "cli_args"):
            sub = subs.add_parser(key.replace("_", "-"), help=value.__doc__)
            for args, kwargs in value.cli_args:
                sub.add_argument(*args, **kwargs)
            sub.set_defaults(action=value)

    args = vars(parser.parse_args())
    action = args.pop("action")
    try:
        for variant in args.pop("variant") or ("release",):
            action(variant=variant, **args)
    except Fail as e:
        sys.exit(e.code)


if __name__ == "__main__":
    _main()
