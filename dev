#!/usr/bin/env python3

"""development runner script"""

import argparse
import hashlib
import subprocess
import sys
import time
import urllib.request
from pathlib import Path
from typing import Any, Callable


def sh(*cmd: str) -> None:
    cmd = tuple(str(c) for c in cmd if c is not None)
    print("$ " + " ".join(cmd), file=sys.stderr)
    if exit_code := subprocess.run(cmd).returncode:
        sys.exit(exit_code)


def sho(cmd: str) -> str:
    return subprocess.run(cmd.split(), capture_output=True, text=True).stdout.strip()


def cli(*args: Any, **kwargs: Any) -> Callable[[Any], Any]:
    """Declare a CLI command / arguments for that command."""

    def wrap(func: Any) -> Any:
        if not hasattr(func, "cli_args"):
            setattr(func, "cli_args", [])
        if args or kwargs:
            getattr(func, "cli_args").append((args, kwargs))
        return func

    return wrap


# Commands

ROOT = Path(__file__).parent.resolve()
CXX = "clang++"
CXXFLAGS = (
    "-Wall -Wextra -Werror -fcolor-diagnostics -ffunction-sections -fdata-sections"
    " -Isrc -isystem third-party"
    f" {sho('pkg-config --cflags sdl2')}"
)
LINKFLAGS = "-fcolor-diagnostics -Wl,--gc-sections -Wl,-no-undefined"
LIBS = sho("pkg-config --libs sdl2") + " -lGL"
CXXFLAGS_VARIANT = {
    "debug": "-O0 -g -DDEBUG",
    "release": "-Os -DNDEBUG",
}

THIRD_PARTY = {
    "doctest": "https://github.com/doctest/doctest/releases/download/v2.4.11/doctest.h"
}


def _generate_build_ninja(variant: str) -> str:
    lines: list[str] = []

    lines.append("rule cxx")
    lines.append(f"  command = {CXX} $cflags -c $in -o $out")
    lines.append("  depfile = $out.d")
    lines.append("  deps = gcc")
    lines.append("  description = CXX $out")
    lines.append("")

    link_cmd = f"{CXX} $in $ldflags -o $out"
    if variant == "release":
        link_cmd += " && strip $out"
    lines.append("rule link")
    lines.append(f"  command = {link_cmd}")
    lines.append("  description = LINK $out")
    lines.append("")

    obj_core, obj_prog, obj_test = [], [], []
    for cpp in sorted(Path("src").rglob("*.cpp")):
        obj = Path("obj") / cpp.relative_to("src").with_suffix(".o")
        cxxflags = f"{CXXFLAGS} {CXXFLAGS_VARIANT[variant]}"
        lines.append(f"build {obj}: cxx {cpp}")
        lines.append(f"  cflags = {cxxflags} -MMD -MF {obj}.d")
        lines.append("")

        if cpp.parent.name == "prog":
            obj_prog.append(obj)
        elif "tests" in cpp.parts:
            obj_test.append(obj)
        else:
            obj_core.append(obj)

    for prog in obj_prog:
        name = Path(prog).with_suffix("").name
        objs = obj_core + [prog] + (obj_test if name == "test" else [])
        lines.append(f"build {name}: link " + " ".join(map(str, objs)))
        lines.append(f"  ldflags = {LINKFLAGS} {LIBS}")
    lines.append("")
    lines.append("default game")

    return "\n".join(lines) + "\n"


@cli()
def clean(variant: str) -> None:
    """clean build artifacts"""
    variant_dir = ROOT / "build" / variant
    if variant_dir.exists():
        sh("rm", "-rf", str(variant_dir))


@cli("targets", nargs="*", help="targets to build")
def build(variant: str, targets: tuple[str, ...]) -> None:
    """build with ninja"""
    variant_dir = ROOT / "build" / variant
    variant_dir.mkdir(parents=True, exist_ok=True)
    for symdir in ("src", "third-party"):
        link = variant_dir / symdir
        if not link.exists():
            link.symlink_to(ROOT / symdir, target_is_directory=True)
    (variant_dir / "build.ninja").write_text(_generate_build_ninja(variant))

    sh("ninja", "-C", str(variant_dir), *targets)
    game = variant_dir / "game"
    if game.exists():
        print(f"  {game.stat().st_size / (1 << 20):.3f} MB  {game.relative_to(ROOT)}")


@cli("program_args", nargs="*", help="program to run")
@cli(
    "--reload",
    action="store_true",
    help="rebuild and restart when the executable changes",
)
def run(variant: str, program_args: tuple[str, ...], reload: bool) -> None:
    """run the command (default: game)"""
    program_args = program_args or ("game",)
    program, *args = program_args
    exe = ROOT / "build" / variant / program

    if not reload:
        build(variant, (program,))
        sh(str(exe), *args)
        return

    def get_src_mtime() -> float:
        srcs = [str(p) for p in (ROOT / "src").rglob("*.cpp")]
        srcs += [str(p) for p in (ROOT / "src").rglob("*.hpp")]
        srcs += [str(ROOT / "dev")]
        return max(Path(s).stat().st_mtime for s in srcs if Path(s).exists())

    def get_exe_hash() -> str | None:
        if not exe.exists():
            return None
        h = hashlib.sha256()
        with open(exe, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 16), b""):
                h.update(chunk)
        return h.hexdigest()

    proc: subprocess.Popen[bytes] | None = None
    try:
        last_src_mtime = get_src_mtime()
        build(variant, (program,))
        last_exe_hash = get_exe_hash()
        proc = subprocess.Popen([str(exe), *args])

        while proc.poll() is None:
            time.sleep(0.1)
            src_mtime = get_src_mtime()
            if src_mtime <= last_src_mtime:
                continue
            last_src_mtime = src_mtime
            build(variant, (program,))
            exe_hash = get_exe_hash()
            ts = time.strftime("%H:%M:%S")
            if exe_hash != last_exe_hash:
                last_exe_hash = exe_hash
                print(f"[{ts}] rebuilt (reloading)")
                if proc.poll() is None:
                    proc.terminate()
                    proc.wait()
                proc = subprocess.Popen([str(exe), *args])
            else:
                print(f"[{ts}] rebuilt (unchanged)")
    except KeyboardInterrupt:
        pass
    finally:
        if proc is not None and proc.poll() is None:
            proc.terminate()
            proc.wait()


@cli()
def ci(variant: str) -> None:
    """run continuous integration checks"""
    build(variant, targets=())
    run(variant, program_args=("test",))


@cli()
def setup(variant: str) -> None:
    """download third-party dependencies"""

    for name, url in THIRD_PARTY.items():
        path = ROOT / "third-party" / name / Path(url).name
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.exists():
            print(f"Downloading {name}...")
            urllib.request.urlretrieve(url, str(path))
            print(f"  {path}")
        else:
            print(f"  {path} (exists)")


# Script
def _main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "-v",
        "--variant",
        action="append",
        choices=["debug", "release"],
    )
    parser.set_defaults(action=lambda **args: run(program_args=(), reload=True, **args))

    subs = parser.add_subparsers()
    for key, value in globals().items():
        if hasattr(value, "cli_args"):
            sub = subs.add_parser(key.replace("_", "-"), help=value.__doc__)
            for args, kwargs in value.cli_args:
                sub.add_argument(*args, **kwargs)
            sub.set_defaults(action=value)

    args = vars(parser.parse_args())
    action = args.pop("action")
    for variant in args.pop("variant") or ("release",):
        action(variant=variant, **args)


if __name__ == "__main__":
    _main()
